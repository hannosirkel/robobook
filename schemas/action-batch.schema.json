{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.books/schemas/action-batch.schema.json",
  "title": "Simplbooks Draft Action Batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company_slug",
    "period",
    "generated_at",
    "batch_id",
    "approval_status",
    "already_present",
    "unresolved_dependencies",
    "reference_artifacts",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "company_slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "period": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "submitted",
        "reversed"
      ]
    },
    "source_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "recon_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "already_present": {
      "type": "array",
      "items": {"type": "object"}
    },
    "unresolved_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {"const": "manual_statement_import_financial_transaction"}
              },
              "required": ["kind"]
            },
            "then": {"$ref": "#/$defs/manual_financial_dependency"}
          }
        ]
      }
    },
    "reference_artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/reference_artifact"}
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "reference_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "posting_policy",
            "discovery_overview",
            "normalized_period",
            "reconciliation",
            "exchange_rates",
            "bank_allocations",
            "woo_tax_allocation",
            "woo_tax_source"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "record_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_kind": {
          "type": "string",
          "enum": ["physical_bank"]
        }
      }
    },
    "manual_financial_split_part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signed_amount", "disposition", "target"],
      "properties": {
        "signed_amount": {"type": "number"},
        "disposition": {
          "type": "string",
          "enum": [
            "generated_invoice_receipt",
            "existing_invoice_receipt",
            "generated_purchase_payment",
            "existing_purchase_payment",
            "direct_sale_receipt",
            "bank_fee_payment",
            "expense_reimbursement_payment",
            "clearing_transfer"
          ]
        },
        "target": {"type": "object"}
      }
    },
    "manual_financial_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "blocking",
        "reason",
        "disposition",
        "statement_id",
        "record_id",
        "date",
        "iban",
        "currency",
        "physical_signed_amount",
        "source_ref",
        "reviewed_rationale",
        "target",
        "split_parts",
        "split_proof",
        "statement_import_proof"
      ],
      "properties": {
        "kind": {"const": "manual_statement_import_financial_transaction"},
        "blocking": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "disposition": {
          "type": "string",
          "enum": [
            "bank_fee_payment",
            "expense_reimbursement_payment",
            "clearing_transfer",
            "reviewed_split"
          ]
        },
        "statement_id": {"type": "string", "minLength": 1},
        "record_id": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "iban": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "physical_signed_amount": {"type": "number"},
        "source_ref": {
          "allOf": [
            {"$ref": "#/$defs/source_ref"},
            {"required": ["record_ref", "source_kind"]}
          ]
        },
        "reviewed_rationale": {"type": "string", "minLength": 1},
        "target": {"type": "object"},
        "split_parts": {
          "type": "array",
          "items": {"$ref": "#/$defs/manual_financial_split_part"}
        },
        "split_proof": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["signed_parts_total", "physical_signed_amount", "equation"],
              "properties": {
                "signed_parts_total": {"type": "number"},
                "physical_signed_amount": {"type": "number"},
                "equation": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "statement_import_proof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "required_evidence"],
          "properties": {
            "status": {"type": "string", "enum": ["pending", "verified"]},
            "required_evidence": {"const": "live_discovery_or_audit"},
            "simplbooks_transaction_id": {"type": "string", "minLength": 1},
            "evidence_ref": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "statement_import_proof": {
                "properties": {"status": {"const": "pending"}},
                "required": ["status"]
              }
            },
            "required": ["statement_import_proof"]
          },
          "then": {"properties": {"blocking": {"const": true}}}
        },
        {
          "if": {
            "properties": {"blocking": {"const": false}},
            "required": ["blocking"]
          },
          "then": {
            "properties": {
              "statement_import_proof": {
                "properties": {"status": {"const": "verified"}},
                "required": ["status", "simplbooks_transaction_id", "evidence_ref"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {"disposition": {"const": "reviewed_split"}},
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "split_parts": {
                "minItems": 1,
                "contains": {
                  "properties": {
                    "disposition": {"enum": ["bank_fee_payment", "expense_reimbursement_payment", "clearing_transfer"]}
                  },
                  "required": ["disposition"]
                }
              }
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_key",
        "period",
        "action_type",
        "method",
        "endpoint",
        "payload",
        "source_refs",
        "reason",
        "confidence",
        "depends_on",
        "expected_effect",
        "review_notes"
      ],
      "properties": {
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "action_type": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE"
          ]
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "payload": {},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_effect": {
          "type": "string",
          "minLength": 1
        },
        "review_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "executed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "response_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "response_body": {},
        "inserted_id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
