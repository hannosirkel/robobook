{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.books/schemas/action-batch.schema.json",
  "title": "Simplbooks Draft Action Batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company_slug",
    "period",
    "generated_at",
    "batch_id",
    "approval_status",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "company_slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "period": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "submitted",
        "reversed"
      ]
    },
    "source_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "recon_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "record_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_key",
        "period",
        "action_type",
        "method",
        "endpoint",
        "payload",
        "source_refs",
        "reason",
        "confidence",
        "depends_on",
        "expected_effect",
        "review_notes"
      ],
      "properties": {
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "action_type": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE"
          ]
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "payload": {},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_effect": {
          "type": "string",
          "minLength": 1
        },
        "review_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "executed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "response_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "response_body": {},
        "inserted_id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
