{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.books/schemas/entity-map.schema.json",
  "title": "Simplbooks Entity Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company_slug",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "company_slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "as_of_period": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "financial_accounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "income_accounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "vat_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "warehouses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "extra": {
          "type": "object",
          "additionalProperties": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
