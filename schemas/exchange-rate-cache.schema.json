{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Annual ECB Exchange Rate Cache",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "year", "base", "quote", "source_url", "retrieved_at", "rates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "provider": {"const": "ECB"},
    "year": {"type": "integer", "minimum": 1999},
    "base": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "quote": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "source_url": {"type": "string", "format": "uri"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "rates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "base", "quote", "rate"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "base": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "quote": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "rate": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}
        }
      }
    }
  }
}
