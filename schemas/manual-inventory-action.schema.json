{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.books/schemas/manual-inventory-action.schema.json",
  "title": "Reviewed Manual Inventory Write-Off",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_type",
    "effective_date",
    "article_id",
    "warehouse_id",
    "quantity",
    "expense_account_id",
    "expected_remnant_after",
    "reason",
    "approval",
    "status",
    "source_refs"
  ],
  "properties": {
    "action_type": {"const": "manual_inventory_writeoff"},
    "effective_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "article_id": {"type": "string", "minLength": 1},
    "warehouse_id": {"type": "string", "minLength": 1},
    "quantity": {"type": "number", "minimum": 0.01},
    "expense_account_id": {"type": "string", "minLength": 1},
    "expected_remnant_after": {"type": "number", "minimum": 0},
    "reason": {"type": "string", "minLength": 1},
    "approval": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["required", "completed", "verified"]},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_ref"}
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "row_ref", "page_ref", "notes"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "row_ref": {"type": ["string", "null"], "minLength": 1},
        "page_ref": {"type": ["string", "null"], "minLength": 1},
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
