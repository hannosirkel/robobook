{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.books/schemas/manual-inventory-action.schema.json",
  "title": "Reviewed Manual Inventory Action",
  "description": "A write-off, warehouse transfer, or year-end adjustment carried out by hand because the published API has no endpoint for it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["action_type", "effective_date", "article_id", "quantity", "reason", "approval", "status", "source_refs"],
  "properties": {
    "action_type": {
      "type": "string",
      "enum": ["manual_inventory_writeoff", "warehouse_transfer", "year_end_adjustment"]
    },
    "effective_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "article_id": {"type": "string", "minLength": 1},
    "warehouse_id": {"type": "string", "minLength": 1},
    "source_warehouse_id": {"type": "string", "minLength": 1},
    "destination_warehouse_id": {"type": "string", "minLength": 1},
    "direction": {"type": "string", "enum": ["increase", "decrease"]},
    "quantity": {"type": "number", "minimum": 0.01},
    "expense_account_id": {"type": "string", "minLength": 1},
    "expected_remnant_after": {"type": "number", "minimum": 0},
    "remnant_before": {"$ref": "#/$defs/remnant_snapshot"},
    "remnant_after": {"$ref": "#/$defs/remnant_snapshot"},
    "reason": {"type": "string", "minLength": 1},
    "approval": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["required", "completed", "complete", "verified"]},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_ref"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action_type": {"const": "manual_inventory_writeoff"}}, "required": ["action_type"]},
      "then": {"required": ["warehouse_id", "expense_account_id", "expected_remnant_after"]}
    },
    {
      "if": {"properties": {"action_type": {"const": "warehouse_transfer"}}, "required": ["action_type"]},
      "then": {
        "required": ["source_warehouse_id", "destination_warehouse_id", "remnant_before", "remnant_after"]
      }
    },
    {
      "if": {"properties": {"action_type": {"const": "year_end_adjustment"}}, "required": ["action_type"]},
      "then": {"required": ["warehouse_id", "direction", "expense_account_id"]}
    }
  ],
  "$defs": {
    "remnant_snapshot": {
      "type": "object",
      "description": "Dated remnant per warehouse, bound before and after the manual operation.",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[0-9]+$"},
      "additionalProperties": {"type": "number"}
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "row_ref", "page_ref", "notes"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "row_ref": {"type": ["string", "null"], "minLength": 1},
        "page_ref": {"type": ["string", "null"], "minLength": 1},
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
