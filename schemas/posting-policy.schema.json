{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company Posting Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "company_slug", "bank_accounts", "contacts", "mappings", "supplier_aliases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "company_slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "bank_accounts": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "object"],
        "pattern": "^[0-9]+$",
        "minProperties": 1,
        "propertyNames": {"pattern": "^[A-Z]{3}$"},
        "additionalProperties": {"type": "string", "pattern": "^[0-9]+$"}
      }
    },
    "contacts": {
      "type": "object",
      "description": "Role-based generic contact labels, including sales/direct-sale when direct bank sales are approved.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "string", "pattern": "^[0-9]+$"}
      }
    },
    "mappings": {
      "type": "object",
      "description": "Generic posting-family keys such as direct-sale-taxable; company-specific IDs belong in values, not family names.",
      "additionalProperties": {
        "$ref": "#/$defs/posting_family"
      }
    },
    "supplier_aliases": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "sales_vat_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sales_vat_profile"}
    },
    "year_expectations": {
      "type": "object",
      "propertyNames": {"pattern": "^[0-9]{4}$"},
      "additionalProperties": {"$ref": "#/$defs/year_expectation"}
    },
    "cash_posting": {"$ref": "#/$defs/cash_posting"},
    "warehouse_routing": {"$ref": "#/$defs/warehouse_routing"}
  },
  "$defs": {
    "id": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
    "required_id": {"type": "string", "pattern": "^[0-9]+$"},
    "cash_posting": {
      "type": "object",
      "description": "Cash-posting mode plus the accounts statement-import mode needs; absent means legacy API cash posting.",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["api", "statement_import"]},
        "bank_income_account_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/required_id"}
        },
        "processor_income_account_ids": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/required_id"}
        },
        "financial_accounts": {
          "type": "object",
          "description": "Reviewed financial-account roles; role names stay generic and company IDs live in the values.",
          "additionalProperties": false,
          "required": [
            "stripe_clearing", "paypal", "bank_fees", "reporting_person_payable",
            "platform_prepayment", "fx_gain", "fx_loss"
          ],
          "properties": {
            "stripe_clearing": {"$ref": "#/$defs/required_id"},
            "paypal": {"$ref": "#/$defs/required_id"},
            "bank_fees": {"$ref": "#/$defs/required_id"},
            "reporting_person_payable": {"$ref": "#/$defs/required_id"},
            "platform_prepayment": {"$ref": "#/$defs/required_id"},
            "fx_gain": {"$ref": "#/$defs/required_id"},
            "fx_loss": {"$ref": "#/$defs/required_id"},
            "customer_receivable": {"$ref": "#/$defs/required_id"},
            "supplier_payable": {"$ref": "#/$defs/required_id"},
            "inventory_change": {"$ref": "#/$defs/required_id"}
          }
        }
      }
    },
    "warehouse_routing_rule": {
      "type": "object",
      "description": "Inclusive order-number boundary between two reviewed fulfilment warehouses.",
      "additionalProperties": false,
      "required": ["before_order", "before_warehouse_id", "from_warehouse_id"],
      "properties": {
        "before_order": {"type": "integer", "minimum": 1},
        "before_warehouse_id": {"$ref": "#/$defs/required_id"},
        "from_warehouse_id": {"$ref": "#/$defs/required_id"}
      }
    },
    "warehouse_routing": {
      "type": "object",
      "description": "Reviewed sales-warehouse routing; an unbound distributor warehouse stays null until it exists.",
      "additionalProperties": false,
      "properties": {
        "woo": {"$ref": "#/$defs/warehouse_routing_rule"},
        "direct_sale_warehouse_id": {"$ref": "#/$defs/id"},
        "distributor_warehouse_id": {"$ref": "#/$defs/id"}
      }
    },
    "sales_vat_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "rate", "goods_vat_type_id", "shipping_vat_type_id"],
      "properties": {
        "start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "end": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "rate": {"type": "number", "minimum": 0},
        "goods_vat_type_id": {"type": "string", "pattern": "^[0-9]+$"},
        "shipping_vat_type_id": {"type": "string", "pattern": "^[0-9]+$"}
      }
    },
    "line_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expense_account_id", "vat_type_id"],
      "properties": {
        "expense_account_id": {"$ref": "#/$defs/id"},
        "vat_type_id": {"$ref": "#/$defs/id"},
        "warehouse_id": {"$ref": "#/$defs/id"}
      }
    },
    "posting_family": {
      "type": "object",
      "description": "Reusable revenue or expense mapping for one reviewed posting family.",
      "additionalProperties": false,
      "properties": {
        "income_account_id": {"$ref": "#/$defs/id"},
        "shipping_income_account_id": {"$ref": "#/$defs/id"},
        "expense_account_id": {"$ref": "#/$defs/id"},
        "vat_type_id": {"$ref": "#/$defs/id"},
        "shipping_vat_type_id": {"$ref": "#/$defs/id"},
        "warehouse_id": {"$ref": "#/$defs/id"},
        "article_id": {"$ref": "#/$defs/id"},
        "lines": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/line_mapping"}
        }
      }
    },
    "year_expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supplier_credit_totals": {
          "type": "object",
          "propertyNames": {"pattern": "^[0-9]{4}-[0-9]{2}$"},
          "additionalProperties": {
            "type": "object",
            "propertyNames": {"pattern": "^[A-Z]{3}$"},
            "additionalProperties": {"type": "number"}
          }
        },
        "suppressed_external_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_blocking_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "label", "family"],
            "properties": {
              "kind": {"type": "string"},
              "label": {"type": "string"},
              "family": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
