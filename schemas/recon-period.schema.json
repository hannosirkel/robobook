{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.books/schemas/recon-period.schema.json",
  "title": "Bookkeeping Reconciliation Period",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company_slug",
    "period",
    "generated_at",
    "approve_for_build",
    "bank_coverage",
    "checks",
    "exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "company_slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "period": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "approve_for_build": {
      "type": "boolean"
    },
    "blocking_issue_count": {
      "type": "integer",
      "minimum": 0
    },
    "bank_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_ready",
        "clearing_ready",
        "physical_bank_row_count",
        "allocated_row_count",
        "unallocated_row_count",
        "credit_total",
        "debit_total",
        "net_movement",
        "ledgers"
      ],
      "properties": {
        "coverage_ready": {"type": "boolean"},
        "clearing_ready": {"type": "boolean"},
        "physical_bank_row_count": {"type": "integer", "minimum": 0},
        "allocated_row_count": {"type": "integer", "minimum": 0},
        "unallocated_row_count": {"type": "integer", "minimum": 0},
        "credit_total": {"type": "number"},
        "debit_total": {"type": "number"},
        "net_movement": {"type": "number"},
        "ledgers": {
          "type": "array",
          "items": {"$ref": "#/$defs/bank_ledger"}
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "bank_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iban",
        "currency",
        "physical_bank_row_count",
        "allocated_row_count",
        "unallocated_row_count",
        "credit_total",
        "debit_total",
        "net_movement",
        "camt_opening_balance",
        "computed_closing_balance",
        "camt_closing_balance"
      ],
      "properties": {
        "iban": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "physical_bank_row_count": {"type": "integer", "minimum": 0},
        "allocated_row_count": {"type": "integer", "minimum": 0},
        "unallocated_row_count": {"type": "integer", "minimum": 0},
        "credit_total": {"type": "number"},
        "debit_total": {"type": "number"},
        "net_movement": {"type": "number"},
        "camt_opening_balance": {"type": ["number", "null"]},
        "computed_closing_balance": {"type": ["number", "null"]},
        "camt_closing_balance": {"type": ["number", "null"]},
        "camt_evidence_scopes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement_from", "statement_to", "balance_type"],
            "properties": {
              "statement_from": {"type": "string", "format": "date"},
              "statement_to": {"type": "string", "format": "date"},
              "balance_type": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_path"
      ],
      "properties": {
        "artifact_path": {
          "type": "string",
          "minLength": 1
        },
        "record_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "name",
        "status"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail",
            "skipped"
          ]
        },
        "lhs_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "lhs_amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "rhs_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "rhs_amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "delta": {
          "type": [
            "number",
            "null"
          ]
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exception_id",
        "severity",
        "summary"
      ],
      "properties": {
        "exception_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warn",
            "error"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "recommended_action": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
