{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.books/schemas/statement-import-evidence.schema.json",
  "title": "Manual Statement Import Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "company_slug", "company_id", "period", "statement_id", "record_id", "transaction_date", "iban", "currency", "signed_amount", "simplbooks_transaction_id", "evidence_kind", "captured_at", "source_identity", "evidence_source"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "company_slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "company_id": {"type": "string", "minLength": 1},
    "period": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "statement_id": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "minLength": 1},
    "transaction_date": {"type": "string", "format": "date"},
    "iban": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "signed_amount": {"type": "number"},
    "simplbooks_transaction_id": {"type": "string", "minLength": 1},
    "evidence_kind": {"enum": ["simplbooks_discovery", "simplbooks_ui_export"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "source_identity": {"$ref": "#/$defs/identity"},
    "evidence_source": {"$ref": "#/$defs/identity"}
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "record_ref"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "record_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
