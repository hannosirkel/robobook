{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.books/schemas/statement-import-plan.schema.json",
  "title": "Annual Statement Import Plan",
  "description": "One reviewed instruction per physical bank statement row for a configured year.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "company_slug", "year", "cash_posting_mode", "rate_bindings", "coverage", "rows"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "company_slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "year": {"type": "integer", "minimum": 1000, "maximum": 9999},
    "cash_posting_mode": {"const": "statement_import"},
    "rate_bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
    "coverage": {"$ref": "#/$defs/coverage"},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9]+$"},
    "money": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "coverage": {
      "type": "object",
      "description": "A zero aggregate difference is not enough; every count is proved separately.",
      "additionalProperties": false,
      "required": ["physical_row_count", "planned_row_count", "uncovered_count", "extra_count", "families", "movement"],
      "properties": {
        "physical_row_count": {"type": "integer", "minimum": 0},
        "planned_row_count": {"type": "integer", "minimum": 0},
        "uncovered_count": {"type": "integer", "minimum": 0},
        "extra_count": {"type": "integer", "minimum": 0},
        "families": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "movement": {"type": "object", "additionalProperties": {"$ref": "#/$defs/money"}}
      }
    },
    "family": {
      "type": "string",
      "enum": [
        "bank_fee",
        "reporting_person_reimbursement",
        "processor_or_internal_transfer",
        "reviewed_split",
        "document_settlement"
      ]
    },
    "financial_account_role": {
      "type": "string",
      "enum": [
        "bank", "stripe_clearing", "paypal", "bank_fees", "reporting_person_payable",
        "platform_prepayment", "customer_receivable", "supplier_payable", "fx_gain",
        "fx_loss", "inventory_change"
      ]
    },
    "accounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "debit": {"$ref": "#/$defs/id"},
        "credit": {"$ref": "#/$defs/id"}
      }
    },
    "account_roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "debit": {"$ref": "#/$defs/financial_account_role"},
        "credit": {"$ref": "#/$defs/financial_account_role"}
      }
    },
    "document_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_type"],
      "properties": {
        "document_type": {"type": "string", "enum": ["invoice", "purchase"]},
        "simplbooks_id": {"type": "string", "minLength": 1},
        "action_key": {"type": "string", "minLength": 1},
        "idempotency_key": {"type": "string", "minLength": 1},
        "action_id": {"type": "string", "minLength": 1}
      }
    },
    "ecb": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["rate", "effective_date", "base", "quote", "converted_amount", "binding"],
      "properties": {
        "rate": {"type": "string", "minLength": 1},
        "effective_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "base": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "quote": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "converted_amount": {"$ref": "#/$defs/money"},
        "binding": {"$ref": "#/$defs/binding"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "sha256", "row_ref"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "row_ref": {"type": "string", "minLength": 1}
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_number", "signed_amount", "disposition", "family", "financial_accounts", "financial_account_roles", "document_refs"],
      "properties": {
        "part_number": {"type": "integer", "minimum": 1},
        "signed_amount": {"$ref": "#/$defs/money"},
        "disposition": {"type": "string", "minLength": 1},
        "family": {"$ref": "#/$defs/family"},
        "financial_accounts": {"$ref": "#/$defs/accounts"},
        "financial_account_roles": {"$ref": "#/$defs/account_roles"},
        "document_refs": {"type": "array", "items": {"$ref": "#/$defs/document_ref"}}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_id", "record_id", "iban", "currency", "period", "date", "signed_amount",
        "counterparty", "description", "disposition", "family", "ui_action",
        "financial_accounts", "financial_account_roles", "document_refs", "ecb", "parts",
        "split_equation", "source", "status", "evidence"
      ],
      "properties": {
        "statement_id": {"type": "string", "minLength": 1},
        "record_id": {"type": "string", "minLength": 1},
        "iban": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "period": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "signed_amount": {"$ref": "#/$defs/money"},
        "counterparty": {"type": "string"},
        "description": {"type": "string"},
        "disposition": {"type": "string", "minLength": 1},
        "family": {"$ref": "#/$defs/family"},
        "ui_action": {
          "type": "string",
          "enum": ["assign_general_ledger", "split_and_assign", "match_document"]
        },
        "financial_accounts": {"$ref": "#/$defs/accounts"},
        "financial_account_roles": {"$ref": "#/$defs/account_roles"},
        "document_refs": {"type": "array", "items": {"$ref": "#/$defs/document_ref"}},
        "ecb": {"$ref": "#/$defs/ecb"},
        "parts": {"type": "array", "items": {"$ref": "#/$defs/part"}},
        "split_equation": {"type": "string"},
        "source": {"$ref": "#/$defs/source"},
        "status": {"type": "string", "enum": ["pending", "completed"]},
        "evidence": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]
        }
      }
    }
  }
}
