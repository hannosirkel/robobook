{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.books/schemas/woo-tax-allocation.schema.json",
  "title": "Reviewed WooCommerce Annual VAT Allocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company_slug",
    "year",
    "source_files",
    "policy",
    "vat_periods",
    "source_rows",
    "allocations",
    "monthly_totals",
    "validation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "company_slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "year": {"type": "integer", "minimum": 1900},
    "source_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_file"}},
    "policy": {"$ref": "#/$defs/policy"},
    "vat_periods": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/vat_period"}},
    "source_rows": {"type": "array", "items": {"$ref": "#/$defs/source_row"}},
    "allocations": {"type": "array", "items": {"$ref": "#/$defs/allocation"}},
    "monthly_totals": {
      "type": "object",
      "propertyNames": {"pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
      "additionalProperties": {"$ref": "#/$defs/month_totals"}
    },
    "validation": {"$ref": "#/$defs/validation"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "money": {"type": "number", "minimum": 0},
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "sha256"],
      "properties": {
        "source_id": {"$ref": "#/$defs/nonempty"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oss_registered", "dispatch_origin", "merchant_absorbs_vat"],
      "properties": {
        "oss_registered": {"type": "boolean"},
        "dispatch_origin": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "merchant_absorbs_vat": {"const": true}
      }
    },
    "vat_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "rate", "goods_vat_type_id", "shipping_vat_type_id"],
      "properties": {
        "start": {"$ref": "#/$defs/date"},
        "end": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "rate": {"type": "number", "minimum": 0},
        "goods_vat_type_id": {"$ref": "#/$defs/nonempty"},
        "shipping_vat_type_id": {"$ref": "#/$defs/nonempty"}
      }
    },
    "source_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_row_id", "tax_code", "configured_rate", "order_tax", "shipping_tax", "total_tax", "orders"],
      "properties": {
        "source_row_id": {"$ref": "#/$defs/nonempty"},
        "tax_code": {"$ref": "#/$defs/nonempty"},
        "configured_rate": {"type": "number", "minimum": 0},
        "order_tax": {"$ref": "#/$defs/money"},
        "shipping_tax": {"$ref": "#/$defs/money"},
        "total_tax": {"$ref": "#/$defs/money"},
        "orders": {"type": "integer", "minimum": 1}
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "row_ref", "page_ref", "notes"],
      "properties": {
        "source_id": {"$ref": "#/$defs/nonempty"},
        "path": {"$ref": "#/$defs/nonempty"},
        "row_ref": {"type": ["string", "null"], "minLength": 1},
        "page_ref": {"type": ["string", "null"], "minLength": 1},
        "notes": {"type": ["string", "null"]}
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_row_id",
        "order_id",
        "period",
        "event_date",
        "country_code",
        "processor_ref",
        "configured_rate",
        "corrected_rate",
        "original_order_tax",
        "original_shipping_tax",
        "fixed_product_gross",
        "fixed_shipping_gross",
        "corrected_product_vat",
        "corrected_shipping_vat",
        "source_refs"
      ],
      "properties": {
        "source_row_id": {"$ref": "#/$defs/nonempty"},
        "order_id": {"$ref": "#/$defs/nonempty"},
        "period": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
        "event_date": {"$ref": "#/$defs/date"},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "processor_ref": {"$ref": "#/$defs/nonempty"},
        "configured_rate": {"type": "number", "minimum": 0},
        "corrected_rate": {"type": "number", "minimum": 0},
        "original_order_tax": {"$ref": "#/$defs/money"},
        "original_shipping_tax": {"$ref": "#/$defs/money"},
        "fixed_product_gross": {"$ref": "#/$defs/money"},
        "fixed_shipping_gross": {"$ref": "#/$defs/money"},
        "corrected_product_vat": {"$ref": "#/$defs/money"},
        "corrected_shipping_vat": {"$ref": "#/$defs/money"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_ref"}}
      }
    },
    "month_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gross", "original_vat", "corrected_vat"],
      "properties": {
        "gross": {"$ref": "#/$defs/money"},
        "original_vat": {"$ref": "#/$defs/money"},
        "corrected_vat": {"$ref": "#/$defs/money"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors"],
      "properties": {
        "status": {"type": "string", "enum": ["pass", "fail"]},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
